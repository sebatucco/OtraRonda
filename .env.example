# Copiá este archivo a .env y completá con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). Nunca subas .env al repositorio.
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Opcional: importar la carta desde una foto con Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
